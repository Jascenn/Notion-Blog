# ============================
# 环境变量配置示例
# ============================
# 复制此文件为 .env.local 并填入真实值

# ============================
# Notion API 配置（必需）
# ============================
# Notion Integration Token
# 获取方式：https://www.notion.so/my-integrations → Create new integration
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 数据库 ID
# 获取方式：打开你的 Notion 数据库，从 URL 中提取
# URL 格式：https://www.notion.so/{workspace}/{数据库ID}?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion API 2025-09-03+ 使用 Data Source ID；不填时网站会从数据库自动发现
NOTION_DATA_SOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================
# 网站配置
# ============================
# 网站 URL
# 本地开发：http://localhost:3000
# 生产环境：https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================
# Umami 访问分析（可选）
# ============================
# 浏览器仅需 Website ID；未配置时不会加载任何分析脚本
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_DOMAINS=lingyi.bio,www.lingyi.bio

# 以下变量只用于服务端/本地导出，不要加 NEXT_PUBLIC_ 前缀
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
UMAMI_API_BASE=https://api.umami.is/v1

# Umami 免费版分享接口（服务端使用，绝不能加 NEXT_PUBLIC_ 前缀）
UMAMI_SHARE_SLUG=
UMAMI_SHARE_GATEWAY=https://gateway-us.umami.is/api

# 每日汇总写入的 Notion 数据源
# 可复用 NOTION_TOKEN，也可单独提供权限更小的 token。
NOTION_ANALYTICS_TOKEN=
NOTION_ANALYTICS_DATA_SOURCE_ID=

# Vercel Cron 调用 /api/cron/analytics 时使用
CRON_SECRET=

# ============================
# Sentry 错误监控（可选）
# ============================
# 获取方式：https://sentry.io → 项目 Settings → Client Keys (DSN)
# 不填则不启用错误上报
NEXT_PUBLIC_SENTRY_DSN=

# ============================
# Vercel KV 配置（可选）
# ============================
# 用于阅读统计功能，本地开发可不配置
# 生产环境部署到 Vercel 后会自动注入
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ============================
# Cloudflare CDN 配置（可选）
# ============================
# 如果使用 Cloudflare CDN 加速，需要配置以下变量

# Cloudflare Global API Key
# 获取方式：Cloudflare Dashboard → My Profile → API Tokens → Global API Key
CLOUDFLARE_API_TOKEN=your_global_api_key_here

# Cloudflare 账户邮箱
CLOUDFLARE_EMAIL=your-email@example.com

# lingyi.bio 域名配置
CLOUDFLARE_ZONE_ID_BIO=your_zone_id_for_bio
DOMAIN_BIO=lingyi.bio

# lingyi.tools 域名配置
CLOUDFLARE_ZONE_ID_TOOLS=your_zone_id_for_tools
DOMAIN_TOOLS=lingyi.tools
