# Notion 配置
# 从 https://www.notion.so/my-integrations 获取
NOTION_SECRET=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 数据库 ID
# 从数据库 URL 中提取: https://www.notion.so/{workspace}/数据库ID?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 网站配置
# 本地开发使用 http://localhost:3000
# 生产环境使用: https://lingyi.bio (无需重定向)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel KV 配置 (用于阅读统计)
# 从 Vercel 项目设置中获取，或访问 https://vercel.com/dashboard/stores
# 本地开发时可以不配置，将使用降级方案（不会报错）
# 生产环境部署到 Vercel 后会自动注入这些变量
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=