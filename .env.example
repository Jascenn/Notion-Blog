# ============================
# 环境变量配置示例
# ============================
# 复制此文件为 .env.local 并填入真实值

# ============================
# Notion API 配置（必需）
# ============================
# Notion Integration Token
# 获取方式：https://www.notion.so/my-integrations → Create new integration
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion 数据库 ID
# 获取方式：打开你的 Notion 数据库，从 URL 中提取
# URL 格式：https://www.notion.so/{workspace}/{数据库ID}?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================
# 网站配置
# ============================
# 网站 URL
# 本地开发：http://localhost:3000
# 生产环境：https://yourdomain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================
# Vercel KV 配置（可选）
# ============================
# 用于阅读统计功能，本地开发可不配置
# 生产环境部署到 Vercel 后会自动注入
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ============================
# Cloudflare CDN 配置（可选）
# ============================
# 如果使用 Cloudflare CDN 加速，需要配置以下变量

# Cloudflare Global API Key
# 获取方式：Cloudflare Dashboard → My Profile → API Tokens → Global API Key
CLOUDFLARE_API_TOKEN=your_global_api_key_here

# Cloudflare 账户邮箱
CLOUDFLARE_EMAIL=your-email@example.com

# lingyi.bio 域名配置
CLOUDFLARE_ZONE_ID_BIO=your_zone_id_for_bio
DOMAIN_BIO=lingyi.bio

# lingyi.tools 域名配置
CLOUDFLARE_ZONE_ID_TOOLS=your_zone_id_for_tools
DOMAIN_TOOLS=lingyi.tools
